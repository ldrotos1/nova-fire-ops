{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apparatus.json",
  "title": "apparatus.yaml",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "label",
      "type",
      "category",
      "home_facility_id",
      "operator",
      "source",
      "last_verified"
    ],
    "properties": {
      "id": { "$ref": "common.json#/$defs/slug" },
      "label": { "$ref": "common.json#/$defs/nonEmptyString" },
      "type": { "$ref": "common.json#/$defs/nonEmptyString" },
      "category": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "common.json#/$defs/category" }
      },
      "als_capable": { "type": "boolean" },
      "status": { "enum": ["frontline", "reserve", "out-of-service"], "default": "frontline" },
      "home_facility_id": { "$ref": "common.json#/$defs/slug" },
      "operator": { "$ref": "common.json#/$defs/nonEmptyString" },
      "volunteer_operator": { "$ref": "common.json#/$defs/slug" },
      "source": { "$ref": "common.json#/$defs/sourceList" },
      "last_verified": { "$ref": "common.json#/$defs/date" }
    }
  }
}
